index=windows (EventCode=1 OR EventCode=4688)
| eval proc=lower(coalesce(Image, New_Process_Name, process_path)), cmd=lower(coalesce(CommandLine, Process_Command_Line, process_command_line))
| where (like(proc,"%\\powershell.exe") OR like(proc,"%\\pwsh.exe"))
  AND (like(cmd,"% -enc %") OR like(cmd,"% -encodedcommand %") OR like(cmd,"% /enc %") OR like(cmd,"% -e %"))
| table _time host user proc cmd ParentImage
