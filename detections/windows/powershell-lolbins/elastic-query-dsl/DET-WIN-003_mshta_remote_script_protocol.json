{
  "query": {
    "bool": {
      "filter": [
        {
          "term": {
            "process.name": {
              "value": "mshta.exe",
              "case_insensitive": true
            }
          }
        }
      ],
      "should": [
        {
          "wildcard": {
            "process.command_line": {
              "value": "*http://*",
              "case_insensitive": true
            }
          }
        },
        {
          "wildcard": {
            "process.command_line": {
              "value": "*https://*",
              "case_insensitive": true
            }
          }
        },
        {
          "wildcard": {
            "process.command_line": {
              "value": "*javascript:*",
              "case_insensitive": true
            }
          }
        },
        {
          "wildcard": {
            "process.command_line": {
              "value": "*vbscript:*",
              "case_insensitive": true
            }
          }
        }
      ],
      "minimum_should_match": 1
    }
  },
  "_source": [
    "@timestamp",
    "host.name",
    "user.name",
    "process.name",
    "process.command_line",
    "process.parent.name",
    "process.parent.command_line"
  ]
}
