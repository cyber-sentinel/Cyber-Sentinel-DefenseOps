// Elastic ES|QL — ECS-compatible Elastic Endpoint process data.
// Adjust the source data stream pattern for the target deployment.
FROM logs-endpoint.events.process-*
| WHERE process.name IN ("powershell.exe", "pwsh.exe") AND (process.command_line LIKE "*invoke-webrequest*" OR process.command_line LIKE "*downloadstring*" OR process.command_line LIKE "*downloadfile*" OR process.command_line LIKE "*webclient*" OR process.command_line LIKE "*start-bitstransfer*")
| KEEP @timestamp, host.name, user.name, process.name, process.command_line, process.parent.name, process.parent.command_line
| SORT @timestamp DESC
