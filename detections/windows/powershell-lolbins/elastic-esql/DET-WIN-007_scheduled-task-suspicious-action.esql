// Elastic ES|QL — ECS-compatible Elastic Endpoint process data.
// Adjust the source data stream pattern for the target deployment.
FROM logs-endpoint.events.process-*
| WHERE process.name == "schtasks.exe" AND process.command_line LIKE "*/create*" AND (process.command_line LIKE "*powershell*" OR process.command_line LIKE "*pwsh*" OR process.command_line LIKE "*cmd /c*" OR process.command_line LIKE "*mshta*" OR process.command_line LIKE "*rundll32*" OR process.command_line LIKE "*regsvr32*" OR process.command_line LIKE "*\\AppData\\*" OR process.command_line LIKE "*\\Temp\\*")
| KEEP @timestamp, host.name, user.name, process.name, process.command_line, process.parent.name, process.parent.command_line
| SORT @timestamp DESC
