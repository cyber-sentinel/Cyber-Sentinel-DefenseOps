DeviceProcessEvents
| extend Proc=tolower(FileName), Cmd=tolower(ProcessCommandLine)
| where Proc in ("powershell.exe", "pwsh.exe") and Cmd has_any (" -enc ", " -encodedcommand ", " /enc ", " -e ")
| project Timestamp, DeviceId, DeviceName, ReportId, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine
