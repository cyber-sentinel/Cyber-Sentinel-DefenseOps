// SentinelOne Singularity Data Lake PowerQuery.
// Validate field availability in the target tenant before promoting to a STAR custom rule.
dataSource.name='SentinelOne' AND endpoint.os='windows' AND event.type='Process Creation' AND tgt.process.name='mshta.exe' AND tgt.process.cmdline contains:anycase ('http://','https://','javascript:','vbscript:')
| columns event.time, endpoint.name, src.process.user, tgt.process.name, tgt.process.cmdline, src.process.name, src.process.cmdline, src.process.parent.name
