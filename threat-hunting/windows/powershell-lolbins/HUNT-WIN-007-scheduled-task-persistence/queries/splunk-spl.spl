index=windows (EventCode=1 OR EventCode=4688)
| eval proc=lower(coalesce(Image, New_Process_Name, process_path, process_name)), cmd=lower(coalesce(CommandLine, Process_Command_Line, process_command_line)), parent=lower(coalesce(ParentImage, InitiatingProcessFileName, parent_process_name)), user=coalesce(User, AccountName, user)
| where (like(proc,"%\\schtasks.exe")) OR (like(parent,"%\\cmd.exe") OR like(parent,"%\\powershell.exe") OR like(parent,"%\\wmic.exe") OR like(parent,"%\\psexec.exe") OR like(parent,"%\\psexesvc.exe") OR like(parent,"%\\services.exe")) OR ((like(proc,"%\\schtasks.exe")) AND (like(cmd,"%/create%") OR like(cmd,"%/change%") OR like(cmd,"%/s %") OR like(cmd,"%powershell%") OR like(cmd,"%pwsh%") OR like(cmd,"%cmd /c%") OR like(cmd,"%mshta%") OR like(cmd,"%rundll32%") OR like(cmd,"%regsvr32%") OR like(cmd,"%\\appdata\\%") OR like(cmd,"%\\temp\\%")))
| eval hunt_reason=case((like(cmd,"%/create%") OR like(cmd,"%/change%") OR like(cmd,"%/s %") OR like(cmd,"%powershell%") OR like(cmd,"%pwsh%") OR like(cmd,"%cmd /c%") OR like(cmd,"%mshta%") OR like(cmd,"%rundll32%") OR like(cmd,"%regsvr32%") OR like(cmd,"%\\appdata\\%") OR like(cmd,"%\\temp\\%")),"suspicious_command_line",(like(parent,"%\\cmd.exe") OR like(parent,"%\\powershell.exe") OR like(parent,"%\\wmic.exe") OR like(parent,"%\\psexec.exe") OR like(parent,"%\\psexesvc.exe") OR like(parent,"%\\services.exe")),"suspicious_parent_context",true(),"process_scope")
| stats count as events min(_time) as first_seen max(_time) as last_seen values(hunt_reason) as reasons values(parent) as parents values(cmd) as command_lines by host user proc
| sort - events
