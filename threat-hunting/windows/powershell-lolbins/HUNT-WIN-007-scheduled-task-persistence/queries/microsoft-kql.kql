DeviceProcessEvents
| extend Proc=tolower(FileName), Cmd=tolower(ProcessCommandLine), Parent=tolower(InitiatingProcessFileName)
| where Proc in ("schtasks.exe") or Parent in ("cmd.exe","powershell.exe","wmic.exe","psexec.exe","psexesvc.exe","services.exe") or (Proc in ("schtasks.exe") and Cmd has_any ("/create","/change","/s ","powershell","pwsh","cmd /c","mshta","rundll32","regsvr32","\appdata\","\temp\"))
| extend HuntReason=case(Cmd has_any ("/create","/change","/s ","powershell","pwsh","cmd /c","mshta","rundll32","regsvr32","\appdata\","\temp\"), "suspicious_command_line", Parent in ("cmd.exe","powershell.exe","wmic.exe","psexec.exe","psexesvc.exe","services.exe"), "suspicious_parent_context", "process_scope")
| project Timestamp, DeviceId, DeviceName, ReportId, ProcessUniqueId, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, HuntReason
| order by Timestamp desc
