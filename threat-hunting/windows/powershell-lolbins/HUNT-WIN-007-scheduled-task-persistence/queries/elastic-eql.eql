process where (process.name in ("schtasks.exe") or process.parent.name in ("cmd.exe", "powershell.exe", "wmic.exe", "psexec.exe", "psexesvc.exe", "services.exe")) and (process.command_line : ("*/create*", "*/change*", "*/s *", "*powershell*", "*pwsh*", "*cmd /c*", "*mshta*", "*rundll32*", "*regsvr32*", "*\\appdata\\*", "*\\temp\\*") or process.parent.name in ("cmd.exe", "powershell.exe", "wmic.exe", "psexec.exe", "psexesvc.exe", "services.exe"))
