(process.name: ("powershell.exe" or "pwsh.exe") or process.parent.name: ("winword.exe" or "excel.exe" or "outlook.exe" or "mshta.exe" or "wscript.exe" or "cscript.exe" or "cmd.exe")) and (process.command_line: ("*invoke-webrequest*" or "*downloadstring*" or "*downloadfile*" or "*system.net.webclient*" or "*start-bitstransfer*" or "*curl *" or "*wget *" or "*http://*" or "*https://*") or process.parent.name: ("winword.exe" or "excel.exe" or "outlook.exe" or "mshta.exe" or "wscript.exe" or "cscript.exe" or "cmd.exe"))
