process where (process.name in ("powershell.exe", "pwsh.exe") or process.parent.name in ("winword.exe", "excel.exe", "outlook.exe", "mshta.exe", "wscript.exe", "cscript.exe", "cmd.exe")) and (process.command_line : ("*invoke-webrequest*", "*downloadstring*", "*downloadfile*", "*system.net.webclient*", "*start-bitstransfer*", "*curl *", "*wget *", "*http://*", "*https://*") or process.parent.name in ("winword.exe", "excel.exe", "outlook.exe", "mshta.exe", "wscript.exe", "cscript.exe", "cmd.exe"))
