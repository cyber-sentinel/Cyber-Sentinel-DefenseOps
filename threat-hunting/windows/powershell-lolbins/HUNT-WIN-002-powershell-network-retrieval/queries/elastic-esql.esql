// Elastic ES|QL — hunt-oriented ECS process query.
// Adjust data stream patterns and field availability for the target deployment.
FROM logs-endpoint.events.process-*
| WHERE process.name IN ("powershell.exe", "pwsh.exe") OR process.parent.name IN ("winword.exe", "excel.exe", "outlook.exe", "mshta.exe", "wscript.exe", "cscript.exe", "cmd.exe")
| WHERE process.command_line LIKE "*invoke-webrequest*" OR process.command_line LIKE "*downloadstring*" OR process.command_line LIKE "*downloadfile*" OR process.command_line LIKE "*system.net.webclient*" OR process.command_line LIKE "*start-bitstransfer*" OR process.command_line LIKE "*curl *" OR process.command_line LIKE "*wget *" OR process.command_line LIKE "*http://*" OR process.command_line LIKE "*https://*" OR process.parent.name IN ("winword.exe", "excel.exe", "outlook.exe", "mshta.exe", "wscript.exe", "cscript.exe", "cmd.exe")
| KEEP @timestamp, host.name, user.name, process.name, process.command_line, process.parent.name, process.parent.command_line
| SORT @timestamp DESC
