process where (process.name in ("powershell.exe", "pwsh.exe") or process.parent.name in ("winword.exe", "excel.exe", "outlook.exe", "powerpnt.exe", "mshta.exe", "wscript.exe", "cscript.exe", "rundll32.exe", "chrome.exe", "msedge.exe", "firefox.exe")) and (process.command_line : ("*-encodedcommand*", "* -enc *", "*executionpolicy bypass*", "*windowstyle hidden*", "*invoke-webrequest*", "*downloadstring*", "*downloadfile*", "*webclient*", "*start-bitstransfer*", "*invoke-expression*", "* iex *") or process.parent.name in ("winword.exe", "excel.exe", "outlook.exe", "powerpnt.exe", "mshta.exe", "wscript.exe", "cscript.exe", "rundll32.exe", "chrome.exe", "msedge.exe", "firefox.exe"))
