index=windows (EventCode=1 OR EventCode=4688)
| eval proc=lower(coalesce(Image, New_Process_Name, process_path, process_name)), cmd=lower(coalesce(CommandLine, Process_Command_Line, process_command_line)), parent=lower(coalesce(ParentImage, InitiatingProcessFileName, parent_process_name)), user=coalesce(User, AccountName, user)
| where (like(proc,"%\\powershell.exe") OR like(proc,"%\\pwsh.exe")) OR (like(parent,"%\\winword.exe") OR like(parent,"%\\excel.exe") OR like(parent,"%\\outlook.exe") OR like(parent,"%\\powerpnt.exe") OR like(parent,"%\\mshta.exe") OR like(parent,"%\\wscript.exe") OR like(parent,"%\\cscript.exe") OR like(parent,"%\\rundll32.exe") OR like(parent,"%\\chrome.exe") OR like(parent,"%\\msedge.exe") OR like(parent,"%\\firefox.exe")) OR ((like(proc,"%\\powershell.exe") OR like(proc,"%\\pwsh.exe")) AND (like(cmd,"%-encodedcommand%") OR like(cmd,"% -enc %") OR like(cmd,"%executionpolicy bypass%") OR like(cmd,"%windowstyle hidden%") OR like(cmd,"%invoke-webrequest%") OR like(cmd,"%downloadstring%") OR like(cmd,"%downloadfile%") OR like(cmd,"%webclient%") OR like(cmd,"%start-bitstransfer%") OR like(cmd,"%invoke-expression%") OR like(cmd,"% iex %")))
| eval hunt_reason=case((like(cmd,"%-encodedcommand%") OR like(cmd,"% -enc %") OR like(cmd,"%executionpolicy bypass%") OR like(cmd,"%windowstyle hidden%") OR like(cmd,"%invoke-webrequest%") OR like(cmd,"%downloadstring%") OR like(cmd,"%downloadfile%") OR like(cmd,"%webclient%") OR like(cmd,"%start-bitstransfer%") OR like(cmd,"%invoke-expression%") OR like(cmd,"% iex %")),"suspicious_command_line",(like(parent,"%\\winword.exe") OR like(parent,"%\\excel.exe") OR like(parent,"%\\outlook.exe") OR like(parent,"%\\powerpnt.exe") OR like(parent,"%\\mshta.exe") OR like(parent,"%\\wscript.exe") OR like(parent,"%\\cscript.exe") OR like(parent,"%\\rundll32.exe") OR like(parent,"%\\chrome.exe") OR like(parent,"%\\msedge.exe") OR like(parent,"%\\firefox.exe")),"suspicious_parent_context",true(),"process_scope")
| stats count as events min(_time) as first_seen max(_time) as last_seen values(hunt_reason) as reasons values(parent) as parents values(cmd) as command_lines by host user proc
| sort - events
