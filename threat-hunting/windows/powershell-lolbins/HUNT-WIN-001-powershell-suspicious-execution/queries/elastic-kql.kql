(process.name: ("powershell.exe" or "pwsh.exe") or process.parent.name: ("winword.exe" or "excel.exe" or "outlook.exe" or "powerpnt.exe" or "mshta.exe" or "wscript.exe" or "cscript.exe" or "rundll32.exe" or "chrome.exe" or "msedge.exe" or "firefox.exe")) and (process.command_line: ("*-encodedcommand*" or "* -enc *" or "*executionpolicy bypass*" or "*windowstyle hidden*" or "*invoke-webrequest*" or "*downloadstring*" or "*downloadfile*" or "*webclient*" or "*start-bitstransfer*" or "*invoke-expression*" or "* iex *") or process.parent.name: ("winword.exe" or "excel.exe" or "outlook.exe" or "powerpnt.exe" or "mshta.exe" or "wscript.exe" or "cscript.exe" or "rundll32.exe" or "chrome.exe" or "msedge.exe" or "firefox.exe"))
