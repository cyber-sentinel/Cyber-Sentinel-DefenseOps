{
  "size": 500,
  "sort": [
    {
      "@timestamp": {
        "order": "desc"
      }
    }
  ],
  "query": {
    "bool": {
      "should": [
        {
          "term": {
            "process.name.keyword": "wmic.exe"
          }
        },
        {
          "term": {
            "process.parent.name.keyword": "wmiprvse.exe"
          }
        },
        {
          "wildcard": {
            "process.command_line.keyword": {
              "value": "*/node:*",
              "case_insensitive": true
            }
          }
        },
        {
          "wildcard": {
            "process.command_line.keyword": {
              "value": "*process call create*",
              "case_insensitive": true
            }
          }
        },
        {
          "wildcard": {
            "process.command_line.keyword": {
              "value": "*process *",
              "case_insensitive": true
            }
          }
        },
        {
          "wildcard": {
            "process.command_line.keyword": {
              "value": "* call *",
              "case_insensitive": true
            }
          }
        },
        {
          "wildcard": {
            "process.command_line.keyword": {
              "value": "* create *",
              "case_insensitive": true
            }
          }
        }
      ],
      "minimum_should_match": 1
    }
  },
  "_source": [
    "@timestamp",
    "host.name",
    "user.name",
    "process.name",
    "process.command_line",
    "process.parent.name",
    "process.parent.command_line"
  ]
}
