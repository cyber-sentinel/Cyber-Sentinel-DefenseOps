process where (process.name in ("regsvr32.exe") or process.parent.name in ("winword.exe", "excel.exe", "outlook.exe", "mshta.exe", "wscript.exe", "cscript.exe", "powershell.exe", "cmd.exe")) and (process.command_line : ("*scrobj.dll*", "*/i:*", "*-i:*", "*/u *", "*http://*", "*https://*", "*.sct*", "*\\appdata\\*", "*\\temp\\*") or process.parent.name in ("winword.exe", "excel.exe", "outlook.exe", "mshta.exe", "wscript.exe", "cscript.exe", "powershell.exe", "cmd.exe"))
