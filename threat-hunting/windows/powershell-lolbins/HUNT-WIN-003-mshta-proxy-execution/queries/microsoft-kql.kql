DeviceProcessEvents
| extend Proc=tolower(FileName), Cmd=tolower(ProcessCommandLine), Parent=tolower(InitiatingProcessFileName)
| where Proc in ("mshta.exe") or Parent in ("winword.exe","excel.exe","outlook.exe","powerpnt.exe","chrome.exe","msedge.exe","firefox.exe","wscript.exe","cscript.exe") or (Proc in ("mshta.exe") and Cmd has_any ("http://","https://","javascript:","vbscript:",".hta",".sct"))
| extend HuntReason=case(Cmd has_any ("http://","https://","javascript:","vbscript:",".hta",".sct"), "suspicious_command_line", Parent in ("winword.exe","excel.exe","outlook.exe","powerpnt.exe","chrome.exe","msedge.exe","firefox.exe","wscript.exe","cscript.exe"), "suspicious_parent_context", "process_scope")
| project Timestamp, DeviceId, DeviceName, ReportId, ProcessUniqueId, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, HuntReason
| order by Timestamp desc
