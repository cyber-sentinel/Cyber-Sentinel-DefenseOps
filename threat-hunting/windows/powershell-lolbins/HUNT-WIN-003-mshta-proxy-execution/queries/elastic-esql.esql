// Elastic ES|QL — hunt-oriented ECS process query.
// Adjust data stream patterns and field availability for the target deployment.
FROM logs-endpoint.events.process-*
| WHERE process.name IN ("mshta.exe") OR process.parent.name IN ("winword.exe", "excel.exe", "outlook.exe", "powerpnt.exe", "chrome.exe", "msedge.exe", "firefox.exe", "wscript.exe", "cscript.exe")
| WHERE process.command_line LIKE "*http://*" OR process.command_line LIKE "*https://*" OR process.command_line LIKE "*javascript:*" OR process.command_line LIKE "*vbscript:*" OR process.command_line LIKE "*.hta*" OR process.command_line LIKE "*.sct*" OR process.parent.name IN ("winword.exe", "excel.exe", "outlook.exe", "powerpnt.exe", "chrome.exe", "msedge.exe", "firefox.exe", "wscript.exe", "cscript.exe")
| KEEP @timestamp, host.name, user.name, process.name, process.command_line, process.parent.name, process.parent.command_line
| SORT @timestamp DESC
