process where (process.name in ("mshta.exe") or process.parent.name in ("winword.exe", "excel.exe", "outlook.exe", "powerpnt.exe", "chrome.exe", "msedge.exe", "firefox.exe", "wscript.exe", "cscript.exe")) and (process.command_line : ("*http://*", "*https://*", "*javascript:*", "*vbscript:*", "*.hta*", "*.sct*") or process.parent.name in ("winword.exe", "excel.exe", "outlook.exe", "powerpnt.exe", "chrome.exe", "msedge.exe", "firefox.exe", "wscript.exe", "cscript.exe"))
