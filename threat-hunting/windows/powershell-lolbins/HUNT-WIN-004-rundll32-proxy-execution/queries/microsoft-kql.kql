DeviceProcessEvents
| extend Proc=tolower(FileName), Cmd=tolower(ProcessCommandLine), Parent=tolower(InitiatingProcessFileName)
| where Proc in ("rundll32.exe") or Parent in ("winword.exe","excel.exe","outlook.exe","powerpnt.exe","mshta.exe","wscript.exe","cscript.exe","cmd.exe","powershell.exe") or (Proc in ("rundll32.exe") and Cmd has_any ("javascript:","vbscript:","http://","https://","\appdata\","\temp\",",#","control_rundll","mshtml"))
| extend HuntReason=case(Cmd has_any ("javascript:","vbscript:","http://","https://","\appdata\","\temp\",",#","control_rundll","mshtml"), "suspicious_command_line", Parent in ("winword.exe","excel.exe","outlook.exe","powerpnt.exe","mshta.exe","wscript.exe","cscript.exe","cmd.exe","powershell.exe"), "suspicious_parent_context", "process_scope")
| project Timestamp, DeviceId, DeviceName, ReportId, ProcessUniqueId, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, HuntReason
| order by Timestamp desc
