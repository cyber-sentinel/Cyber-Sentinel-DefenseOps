process where (process.name in ("rundll32.exe") or process.parent.name in ("winword.exe", "excel.exe", "outlook.exe", "powerpnt.exe", "mshta.exe", "wscript.exe", "cscript.exe", "cmd.exe", "powershell.exe")) and (process.command_line : ("*javascript:*", "*vbscript:*", "*http://*", "*https://*", "*\\appdata\\*", "*\\temp\\*", "*,#*", "*control_rundll*", "*mshtml*") or process.parent.name in ("winword.exe", "excel.exe", "outlook.exe", "powerpnt.exe", "mshta.exe", "wscript.exe", "cscript.exe", "cmd.exe", "powershell.exe"))
