index=windows (EventCode=1 OR EventCode=4688)
| eval proc=lower(coalesce(Image, New_Process_Name, process_path, process_name)), cmd=lower(coalesce(CommandLine, Process_Command_Line, process_command_line)), parent=lower(coalesce(ParentImage, InitiatingProcessFileName, parent_process_name)), user=coalesce(User, AccountName, user)
| where (like(proc,"%\\psexec.exe") OR like(proc,"%\\psexec64.exe") OR like(proc,"%\\psexesvc.exe")) OR (like(parent,"%\\services.exe")) OR ((like(proc,"%\\psexec.exe") OR like(proc,"%\\psexec64.exe") OR like(proc,"%\\psexesvc.exe")) AND (like(cmd,"%psexec%") OR like(cmd,"%psexesvc%") OR like(cmd,"%cmd.exe%") OR like(cmd,"%powershell.exe%") OR like(cmd,"%pwsh.exe%") OR like(cmd,"%\\admin$%") OR like(cmd,"%\\ipc$%")))
| eval hunt_reason=case((like(cmd,"%psexec%") OR like(cmd,"%psexesvc%") OR like(cmd,"%cmd.exe%") OR like(cmd,"%powershell.exe%") OR like(cmd,"%pwsh.exe%") OR like(cmd,"%\\admin$%") OR like(cmd,"%\\ipc$%")),"suspicious_command_line",(like(parent,"%\\services.exe")),"suspicious_parent_context",true(),"process_scope")
| stats count as events min(_time) as first_seen max(_time) as last_seen values(hunt_reason) as reasons values(parent) as parents values(cmd) as command_lines by host user proc
| sort - events
